# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Pinecone ─────────────────────────────────────────────────────────────────
PINECONE_API_KEY=
# Not needed while the staging bucket is public — an Integration ID is only
# required for private buckets. Leave blank.
PINECONE_STORAGE_INTEGRATION_ID=
# Index region. Leave blank to match AWS_REGION (keeps S3->Pinecone transfer free).
PINECONE_REGION=

# ── OpenAI (embeddings) ──────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── AWS S3 (bulk-import staging bucket) ──────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
S3_PREFIX=sec10k-and-transcripts
