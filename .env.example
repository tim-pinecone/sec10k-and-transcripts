# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Pinecone ─────────────────────────────────────────────────────────────────
PINECONE_API_KEY=
# Integration ID from https://app.pinecone.io/organizations/-/projects/-/storage
PINECONE_STORAGE_INTEGRATION_ID=

# ── OpenAI (embeddings) ──────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── AWS S3 (bulk-import staging bucket) ──────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
S3_PREFIX=sec10k-and-transcripts
